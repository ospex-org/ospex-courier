# The courier's settings. Each is read from the environment; this file lists them with no values.
# Heroku sets DATABASE_URL and PORT itself.

# The courier's own Postgres (secret: it carries the database's password).
DATABASE_URL=

# The node. https only; plain http is taken only to this machine, where the tests run a local chain
# (secret: the URL carries a provider key).
POLYGON_RPC_URL=

# Where the set is: the signpost's address, and the betting entry's number on it.
SIGNPOST_ADDRESS=
BETTING_ENTRY_ID=

# The courier's key's address: an address, never a key. Required: the courier does not start without it.
COURIER_ADDRESS=

# Under this many POL the key's wallet is reported low. 3 unless set.
COURIER_LOW_POL=

# The key: the encrypted keystore `cast wallet new` writes, whole, and its password (secret, both). Required. The
# keystore's address must be COURIER_ADDRESS. Opened once at start; both leave the process's environment then.
COURIER_KEYSTORE_JSON=
COURIER_KEYSTORE_PASSWORD=

# Optional: a transaction of the chain that reverted, which the node's check traces.
TRACE_CHECK_TRANSACTION=

# Where the process listens.
PORT=
