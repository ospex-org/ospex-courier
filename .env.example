# The courier's settings. Each is read from the environment; this file lists them with no values.
# Heroku sets DATABASE_URL and PORT itself.

# The courier's own Postgres (secret: it carries the database's password).
DATABASE_URL=

# The node. https only; plain http is taken only to this machine, where the tests run a local chain
# (secret: the URL carries a provider key).
POLYGON_RPC_URL=

# Where the set is: the signpost's address, and the betting entry's number on it.
SIGNPOST_ADDRESS=
BETTING_ENTRY_ID=

# Under this many POL the key's wallet is reported low. 3 unless set.
COURIER_LOW_POL=

# Where the process listens.
PORT=
